{
  "name": "recurrence_nextmonth_xgb",
  "status": "experiment (2026-11-15) — adoption decided by data lead",
  "created": "2026-11-15",
  "target": "P(next month 0.1° cell harmonized value >= 1), VIIRS-equivalent",
  "display": "과거 반복 패턴 기반 전망(예측 정확도 표시) — not a weather/physics forecast",
  "regions": {
    "KR": "korea_cell_sgg_weights cells (1,123)",
    "ARG": "Natural Earth ADM0 ARG cells (28,589)"
  },
  "label_rule": "label only where aoi_month.status == ok for that country-month; no row in harmonized_cell_month = 0",
  "data_years": [
    "2001-01",
    "2026-07 (labels; final model trained on 2002-01 .. 2026-07 ok months)"
  ],
  "pre_2012_note": "2001–2011 values are MODIS→VIIRS model values (m2v), not VIIRS observations",
  "features": [
    "rec",
    "n_prior",
    "act3",
    "act5",
    "logv_mean",
    "nb3_rec",
    "nb5_rec",
    "lag1_act",
    "lag2_act",
    "lag3_act",
    "lag1_anom",
    "lag2_anom",
    "lag3_anom",
    "fwi_prev",
    "fwi_prev_rel",
    "month_sin",
    "month_cos",
    "lat",
    "lon",
    "is_kr"
  ],
  "feature_notes": {
    "rec": "same calendar month, all valid years from 2001 to the year before the target",
    "lag_k": "k months before the target; partial current month uses value_projected (month-to-date projection)",
    "fwi_prev_rel": "percentile of previous month mean FWI among the same month of earlier years only (>=3 years); NaN before",
    "fwi_coverage": "FWI exists only at NASA POWER points used by the spread nowcast (0.5°); other cells NaN"
  },
  "params": {
    "objective": "binary:logistic",
    "eval_metric": "logloss",
    "device": "cuda",
    "tree_method": "hist",
    "max_depth": 6,
    "learning_rate": 0.08,
    "min_child_weight": 10,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "lambda": 1.0,
    "max_bin": 256,
    "seed": 42
  },
  "rounds": 87,
  "validation": "expanding window, test years 2016–2025, inner early stopping on Y-1",
  "fold_rounds": [
    {
      "test_year": 2016,
      "rounds": 54,
